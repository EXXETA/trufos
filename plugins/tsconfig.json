{
  // Plugins run in the main process, like src/main, and use the plugin API in src/shim/plugin only.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["**/*"],
  // Build tooling, covered by the root tsconfig.json instead.
  "exclude": ["vitest.config.mts", "**/node_modules"]
}
