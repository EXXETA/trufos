{
  "name": "trufos",
  "productName": "Trufos",
  "version": "1.0.0",
  "description": "Trufos - A cross-platform REST client",
  "main": ".vite/build/main.cjs",
  "repository": "github:EXXETA/trufos",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge release",
    "lint": "eslint .",
    "typecheck": "tsc -p src/shim && tsc -p src/main && tsc -p src/renderer && tsc -p plugins && tsc -p e2e && tsc -p .",
    "prettier": "prettier --write '**/*.{ts,tsx,mts,mjs,cjs}'",
    "prettier-check": "prettier --check '**/*.{ts,tsx,mts,mjs,cjs}'",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.0.0",
    "eslint": "^10.13.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "memfs": "^4.80.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [],
  "author": {
    "name": "The Trufos Authors"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "4.8.0-rc.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@zip.js/zip.js": "^2.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "immer": "^11.2.9",
    "lucide-react": "1.61.0",
    "mime-types": "^3.0.2",
    "monaco-editor": "^0.57.0",
    "openid-client": "^6.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "template-replace-stream": "^3.0.1",
    "undici": "^8.12.3",
    "update-electron-app": "^3.3.0",
    "winston": "^3.19.0",
    "xml-formatter": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "packageManager": "yarn@4.18.1"
}
