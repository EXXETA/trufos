{
  "compilerOptions": {
    "target": "ES2024",
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/renderer/*"],
      "main/*": ["./src/main/*"],
      "shim": ["./src/shim/index.ts"],
      "shim/*": ["./src/shim/*"]
    }
  }
}
